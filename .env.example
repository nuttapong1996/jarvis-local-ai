# คัดลอกไฟล์นี้เป็น .env:  cp .env.example .env

# ── Local AI / LM Studio ────────────────────────────────────
# เปิด LM Studio > Developer > Start Server ก่อนใช้งาน
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# เว้นว่าง = ใช้โมเดลแรกที่ LM Studio /v1/models รายงาน
LMSTUDIO_MODEL=
# เว้นว่าง = Computer/Browser Agent ใช้โมเดลเดียวกัน
AGENT_MODEL=
CONF_MIN=0.65
COMPOUND_MIN=0.5

# ── เสียงพูด ──────────────────────────────────────────────
TTS_VOICE=Kanya
TTS_RATE=230
TTS_PITCH=28

# ── การฟังและการคุย ──────────────────────────────────────
WAKE_WORD=น้องจาง
CONVO_SEC=30
BARGE_IN=auto
SILENCE_MS=550
VAD_THRESHOLD=0.5
EXTRA_APPS=auto

# ── หน้าจอ ────────────────────────────────────────────────
MENUBAR=on
HUD=on

# ── ถอดเสียง ──────────────────────────────────────────────
# auto = Apple Speech ก่อน ถ้าใช้ไม่ได้ fallback เป็น Whisper
# apple = Apple Speech เท่านั้น · whisper = Whisper เท่านั้น
STT_ENGINE=auto
MLX_WHISPER_REPO=mlx-community/whisper-large-v3-turbo
WHISPER_PROMPT_MODE=auto
# ถ้า transcript หลักมีความมั่นใจต่ำ ให้ถอดซ้ำด้วยโมเดลที่จูนไทย
STT_SECOND_OPINION=auto
SAVE_UTTERANCES=
LOG_HEARD=

# ── Chrome / Browser Agent ─────────────────────────────────
CHROME_PROFILE=
